{
    "manifest_version": 3,
    "name": "SentinelGuard - Threat Predictor",
    "version": "1.0.0",
    "description": "Proactive zero-day phishing detection and emergency fraud triage.",
    "permissions": [
        "webNavigation",
        "storage",
        "tabs",
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://sentinelguard-worker.surefireprotect.workers.dev/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_start"
        }
    ]
}